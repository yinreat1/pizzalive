{
  "entities": {
    "restaurant_info": {
      "title": "Restaurant Information",
      "description": "General restaurant details for Pizza Live Silopi",
      "type": "document",
      "path": "restaurant_info/main",
      "schema": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "tagline": { "type": "string" },
          "city": { "type": "string" },
          "address": { "type": "string" },
          "phone": { "type": "string" },
          "phoneDisplay": { "type": "string" },
          "instagramHandle": { "type": "string" },
          "instagramUrl": { "type": "string" },
          "mapsUrl": { "type": "string" },
          "workingHours": { "type": "string" }
        }
      }
    },
    "hero_content": {
      "title": "Hero Section Content",
      "description": "Text displayed in homepage hero section",
      "type": "document",
      "path": "hero_content/main",
      "schema": {
        "type": "object",
        "properties": {
          "badge": { "type": "string" },
          "titleHighlight": { "type": "string" },
          "titleRest": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "menu_items": {
      "title": "Menu Items",
      "description": "Restaurant menu items",
      "type": "collection",
      "path": "menu_items",
      "schema": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "category": { "type": "string" },
          "isPopular": { "type": "boolean" },
          "image": { "type": "string" }
        }
      }
    }
  }
}
